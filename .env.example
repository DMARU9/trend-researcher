# OpenCode API (OpenAI-compatible) - OpenDeepResearch 設定を流用
OPENAI_API_KEY=
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1

# Trend Researcher 設定（共通 TR_* / プラットフォーム固有 XTR_・YTR_）
TR_MODEL=openai:mimo-v2.5
# 解析対象件数の既定値（指示で上書き可）
TR_MAX_RESULTS=5
# 中間成果物のキャッシュ先ディレクトリ
TR_CACHE_DIR=cache
# LLM 呼び出しの最大リトライ回数
TR_MAX_RETRIES=3

# --- X（Twitter）用 ---
# twscrape が使用するアカウント DB（クッキーを保存）
XTR_ACCOUNTS_DB=accounts.db
# いいね順ソート用の検索プールサイズ
XTR_SEARCH_POOL_SIZE=50

# --- YouTube 用 ---
# 字幕取得の優先言語（既定: ja）
YTR_TRANSCRIPT_LANG=ja
